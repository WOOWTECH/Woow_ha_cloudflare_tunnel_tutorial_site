    .btn-pill { background: var(--ww-blue); color: #fff; }
    .btn-pill:hover { background: var(--ww-blue-700); color: #fff; text-decoration: none; transform: translateY(-1px); }
    .btn-ghost { background: var(--surface-card); color: var(--text-primary); border: 1.5px solid var(--hairline); }
    .btn-ghost:hover { border-color: var(--ww-blue); color: var(--ww-blue-700); text-decoration: none; }
    .btn-ghost svg, .btn-pill svg { flex-shrink: 0; }
    .dl-note {
      margin: 26px 0 0; padding: 14px 18px; border-radius: var(--radius-sm);
      background: var(--ww-blue-050); border: 1px solid rgba(97,131,252,0.18);
      font-size: 13.5px; color: var(--text-secondary);
    }
    .link-row { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 14px; font-size: 14px; }
    @media (max-width: 720px) { .res-grid { grid-template-columns: 1fr; } }
