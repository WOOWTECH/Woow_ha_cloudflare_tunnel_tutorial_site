    </footer>
  </main>
</div>

<script>
(function () {
  var sidebar = document.getElementById('sidebar');
  var toggle = document.getElementById('navToggle');
  var mq = window.matchMedia('(max-width: 960px)');
  function applyCollapse(e) {
    if (e.matches) { sidebar.classList.add('is-collapsed'); }
    else { sidebar.classList.remove('is-collapsed'); }
  }
  applyCollapse(mq);
  mq.addEventListener ? mq.addEventListener('change', applyCollapse) : mq.addListener(applyCollapse);
  toggle.addEventListener('click', function () { sidebar.classList.toggle('is-collapsed'); });
  sidebar.querySelectorAll('.toc-in-chapter a').forEach(function (a) {
    a.addEventListener('click', function () { if (mq.matches) sidebar.classList.add('is-collapsed'); });
  });

  var links = Array.prototype.slice.call(sidebar.querySelectorAll('.toc-in-chapter a[href^="#"]'));
  var map = {};
  links.forEach(function (a) { map[a.getAttribute('href').slice(1)] = a; });
  var sections = Array.prototype.slice.call(document.querySelectorAll('main section[id]'));
  function onScroll() {
    var current = null;
    for (var i = 0; i < sections.length; i++) {
      if (sections[i].getBoundingClientRect().top <= 120) current = sections[i].id;
    }
    links.forEach(function (a) { a.classList.remove('active'); });
    if (current && map[current]) map[current].classList.add('active');
  }
  window.addEventListener('scroll', onScroll, { passive: true });
  onScroll();
})();
</script>
</body>
</html>
